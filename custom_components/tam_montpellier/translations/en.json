  "options": {
    "step": {
      "init": {
        "title": "Bus lines and added runs",
        "description": "Extra lines to offer next to the tram lines. Pick the bus lines you want to follow, then use \"Add stop\" to choose the stops.\n\nA line with a followed stop cannot be removed.\n\nDuring disruptions, TaM publishes replacement runs next to the regular trips. Like the official M'Ticket app, they are hidden unless you show them here.",
        "data": {
          "extra_routes": "Bus lines",
          "include_added_trips": "Show the runs added by TaM (replacement services)"
        }
      }
    },
    "error": {
      "route_in_use": "These lines still have a followed stop: {lines}. Remove their stops first."
    },
    "abort": {
      "entry_not_loaded": "The integration is not loaded: bus lines cannot be listed."
    }
  },
  "issues": {
    "gtfs_stale": {
      "title": "TaM timetables are out of date",
      "description": "The TaM timetables (GTFS) were last downloaded on {date}, or they list no service for today and tomorrow. Departures may be missing or wrong.\n\nCheck that Home Assistant can reach the timetables address (integration page, \"Reconfigure\"). The integration downloads them again every night; this message goes away once a current archive is loaded."
    },
    "stop_missing": {
      "title": "Stop no longer served: {stop}",
      "description": "The stop \"{stop}\" is no longer in the TaM timetables: its sensors show no departure. The operator may have renamed or moved it.\n\nOn the integration page, delete this stop and add it again with \"Add stop\"."
    },
    "route_missing": {
      "title": "Line {line} is no longer in the timetables",
      "description": "Line {line} is no longer in the TaM timetables. Followed stops on this line: {stops}. Their sensors show no departure.\n\nIf the line was renumbered, delete these stops on the integration page and add them again on the new line."
    }
  },
  "services": {
    "get_departures": {
      "name": "Get departures",
      "description": "Returns the next departures of a followed stop, as listed by its minutes sensor.",
      "fields": {
        "device_id": {
          "name": "Stop",
          "description": "The followed stop."
        },
        "count": {
          "name": "Count",
          "description": "How many departures to return (1 to 20)."
        },
        "stop_id": {
          "name": "Stop id",
          "description": "Instead of the stop: GTFS id of a followed stop."
        },
        "route_id": {
          "name": "Line id",
          "description": "With the stop id: GTFS id of the line."
        },
        "direction_id": {
          "name": "Direction",
          "description": "With the stop id: direction of the line, 0 or 1."
        }
      }
    }
  }
