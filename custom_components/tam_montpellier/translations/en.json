{
  "config": {
    "step": {
      "user": {
        "title": "TaM Montpellier",
        "description": "Real-time departures of the Montpellier tramway (TaM open data, ODbL licence).\n\nOnce the integration is added, use \"Add stop\" to pick the stops to follow.",
        "sections": {
          "advanced": {
            "name": "Advanced: data sources",
            "description": "The default addresses are fine; only change them if the operator moves the feeds.",
            "data": {
              "trip_updates_url": "Real-time feed (GTFS-RT TripUpdate)",
              "gtfs_url": "Timetables (GTFS)",
              "alerts_url": "Service alerts (GTFS-RT Alert)",
              "vehicle_positions_url": "Vehicle positions (GTFS-RT VehiclePosition)"
            }
          }
        }
      },
      "reconfigure": {
        "title": "TaM data sources",
        "description": "Change the addresses of the TaM feeds. The followed stops are kept.",
        "sections": {
          "advanced": {
            "name": "Data sources",
            "data": {
              "trip_updates_url": "Real-time feed (GTFS-RT TripUpdate)",
              "gtfs_url": "Timetables (GTFS)",
              "alerts_url": "Service alerts (GTFS-RT Alert)",
              "vehicle_positions_url": "Vehicle positions (GTFS-RT VehiclePosition)"
            }
          }
        }
      }
    },
    "error": {
      "cannot_connect": "Unable to reach the real-time feed.",
      "invalid_feed": "The real-time feed address does not return a valid GTFS-RT feed.",
      "gtfs_cannot_connect": "Unable to reach the timetables (GTFS).",
      "invalid_gtfs": "The timetables address does not return a GTFS archive (zip)."
    },
    "abort": {
      "single_instance_allowed": "The integration is already configured. Add stops from its page.",
      "reconfigure_successful": "The data sources are updated."
    }
  },
  "config_subentries": {
    "stop": {
      "entry_type": "Stop",
      "initiate_flow": {
        "user": "Add stop",
        "reconfigure": "Walk to the stop"
      },
      "step": {
        "user": {
          "title": "Select the line",
          "data": {
            "route_id": "Line"
          }
        },
        "direction": {
          "title": "Select the direction",
          "description": "{line}: which way are you travelling?",
          "data": {
            "direction_id": "Direction"
          }
        },
        "stop": {
          "title": "Select the stop",
          "description": "{line} towards {direction}.",
          "data": {
            "stop_id": "Stop",
            "walk_minutes": "Walk to the stop (min)",
            "leave_window": "Warn before leaving (min)"
          },
          "data_description": {
            "walk_minutes": "Optional. Adds a \"minutes before leaving\" sensor and a \"time to leave\" binary sensor.",
            "leave_window": "How long before leaving \"time to leave\" turns on (2 min if empty)."
          }
        },
        "reconfigure": {
          "title": "Walk to the stop",
          "description": "{stop}: time walked to the stop. Leave it empty to remove the \"time to leave\" entities.",
          "data": {
            "walk_minutes": "Walk to the stop (min)",
            "leave_window": "Warn before leaving (min)"
          },
          "data_description": {
            "leave_window": "How long before leaving \"time to leave\" turns on."
          }
        }
      },
      "abort": {
        "already_configured": "This stop is already followed for this line and direction.",
        "entry_not_loaded": "The integration is not loaded: stops cannot be listed.",
        "reconfigure_successful": "The stop is updated."
      }
    }
